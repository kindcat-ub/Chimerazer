# Chimerazer: give the logged-in user access to the hidraw nodes of
# supported Razer devices, without root.
#
# Install:
#   sudo cp 70-chimerazer.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# The rule number must stay below 73 so that "uaccess" is applied by
# systemd-logind (73-seat-late.rules).

# Razer Naga Pro: wired, 2.4 GHz receiver
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1532", ATTRS{idProduct}=="008f", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1532", ATTRS{idProduct}=="0090", TAG+="uaccess"
