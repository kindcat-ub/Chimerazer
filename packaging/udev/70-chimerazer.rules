# Chimerazer: give the logged-in user access to the hidraw nodes of
# supported Razer devices, without root.
#
# Install:
#   sudo cp 70-chimerazer.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# The rule number must stay below 73 so that "uaccess" is applied by
# systemd-logind (73-seat-late.rules).

# All hidraw nodes of Razer devices. The control interface is found at run
# time by its 90-byte feature report, not by a product list, so a model or
# mode change (new product ID) needs no rule update.
#
# Note: all ATTRS keys of one rule must match the same parent device, so
# USB interface attributes cannot be combined with idVendor here.
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1532", TAG+="uaccess"
